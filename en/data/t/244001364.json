[[8,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Disconnect the negative battery terminal.</p><p><a href=\"#/244001539\">Op. 7055B54 UNDER-ENGINE GUARD - R R</a></p><p><strong>See in Op. 1088B32</strong></p><p>-</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000463.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Starter motor</p></td><td><p>A020A</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244004466.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,3,0,"<p>- Lower the vehicle using the lift.</p><p>1. Disconnect the battery lead undoing the fixing nut.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000463.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Maxifuse box on battery</p></td><td><p>B099H</p></td></tr></table></div><p>- Remove the lead between the battery and the starter motor.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244004467.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Connect the battery lead tightening the fixing nut.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000463.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>.</p></td><td><p>Maxifuse box on battery</p></td><td><p>B099H</p></td></tr></table></div><p>- Raise the vehicle using the lift.</p><p>- Connect the lead to the starter motor tightening the fixing nut.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000463.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>.</p></td><td><p>Starter motor</p></td><td><p>A020A</p></td></tr></table></div><p><strong>See in Op. 1088B32</strong></p><p><a href=\"#/244001539\">Op. 7055B54 UNDER-ENGINE GUARD - R R</a></p><p>-</p>"]]