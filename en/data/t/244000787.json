[[1,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the fastening bands (1a) and undo the fixing nuts on the tappet cover (1b) and remove the rigid pipe (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244002724.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the rigid pipe in position and renew the fastening bands.</p><p>- Tighten the nuts fixing the rigid pipe to the tappet cover.</p>"]]