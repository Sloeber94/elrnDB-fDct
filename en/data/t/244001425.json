[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Loosen the bolts fixing the striker.</p><p>2. Remove the door lock striker.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244004570.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Fit the door lock striker tightening the fixing bolts.</p><p>2. Adjust the lock striker (2a) in the directions (2b) illustrated in the diagram.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244004571.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>- Tighten the fixing bolts to the recommended torque.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000559.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Value - daNm</p></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th></tr><tr><td><p>.</p></td><td><p>2,4</p></td><td><p>-</p></td><td><p>STRIKER ON FRONT SIDE DOOR PILLAR</p></td><td><p>-</p></td></tr></table></div>"]]