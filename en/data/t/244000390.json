[[1,3,36028797018963968,"<aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>The LPG canister is certified in accordance with European standard ECE R67/01. The canister lasts for 10 years; after this time it must be replaced.</p></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244000178.jpg\" alt=\"\" loading=\"lazy\"></figure><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244000179.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]