[[1,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Open the hose retaining bands.</p><p>2. Release the hose from the air filter casing and from the rigid pipe and remove it.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244002725.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the hose on the air filter casing and on the rigid pipe and restore the fastening bands.</p>"]]