[[8,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the bush (1a) from the small end using a hydraulic press, a suitable plate (1b) and the tool (1c).</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000499.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Code</p></th><th><p>Function</p></th></tr><tr><td><p>1c</p></td><td><p>Fitting tool</p></td><td><p>1.860.624.000</p></td><td><p>Small end bush removal/introduction</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244002389.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Fit a new bush (1a) in the small end using a hydraulic press, a suitable plate (1b) and the tool (1c).</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>The bush should be fitted in the small end so that the lubrication port is aligned with the one in the small end.</p></aside><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000499.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Code</p></th><th><p>Function</p></th></tr><tr><td><p>1c</p></td><td><p>Fitting tool</p></td><td><p>1.860.624.000</p></td><td><p>Small end bush removal/introduction</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244002390.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,3,0,"<p>- Ream the inner diameter of the small end bush to the recommended figure.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000504.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Subject</p></th><th><p>Value</p></th></tr><tr><td><p>.</p></td><td><p>Engine connecting rod small end bush</p></td><td><p>mm</p></td></tr><tr><td><p>-</p></td><td><p>Inner diameter</p></td><td><p>32,010 - 32,020</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244002391.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]