[[1,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Position a suitable container for collecing the fluid inside the engine oil intake.</p><p>1. Undo the bolts fixing the engine oil intake (1a), remove the casing (1b) and the engine oil intake (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244003051.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the engine oil intake.</p><p>- Fit the casing.</p><p>- Tighten the bolts fixing the intake.</p>"],[4,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Unscrew the bolts securing the intake to the sump.</p><p>2. Undo retaining nut (2a) and remove engine oil intake (2b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244003052.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the engine oil intake.</p><p>- Tighten the nut and bolts securing the intake to the crankcase and the oil return pipe to the sump.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000559.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Value - daNm</p></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th></tr><tr><td><p>.</p></td><td><p>1</p></td><td><p>Bolt</p></td><td><p>OIL SECTION PUMP</p></td><td><p>M6</p></td></tr></table></div>"],[8,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the fixing bolts (1a) and remove the engine oil intake duct (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244003053.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[8,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the engine oil intake duct and tighten the fixing bolts.</p>"],[2,3,0,"<p><strong>See in Op. 1084B10</strong></p>"]]