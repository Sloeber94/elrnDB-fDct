[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><a href=\"#/244001473\">Op. 7020E34 REAR DOOR FLAP INTERIOR PANEL - R+R</a></p><p>1. Release the door opening control lever rod from the lock.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244004658.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>1. Undo the bolt fixing the lever.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244004659.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>- Remove the lever complete with rod.</p>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Position the lever attaching the rod to the lock.</p><p>- Tighten the retaining bolt.</p><p><a href=\"#/244001473\">Op. 7020E34 REAR DOOR FLAP INTERIOR PANEL - R+R</a></p>"]]