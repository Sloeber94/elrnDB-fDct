[[1,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Disconnect the electrical connection (1a) and open the fastening bands (1b).</p><p>2. Remove the heater.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244005788.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the heater in position and tighten the retaining bands.</p><p>- Connect the electrical connection.</p>"]]