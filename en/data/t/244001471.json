[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolt fixing the interior handle.</p><p>2. Remove the sliding door interior handle.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244004640.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Position the interior handle in the special housing in the sliding door.</p><p>- Fasten the interior handle to the sliding door tightening the fixing bolt.</p>"]]