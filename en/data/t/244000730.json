[[4,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Remove the oil seal from its seat on the intake manifold shaft.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>When removing, take care not to scratch the camshaft and its seat.</p></aside>"],[4,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Use the tool to fit a new oil seal to the intake side camshaft. Tighten the tool screw to bring the oil seal into contact with the seat in the head extension.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/244000499.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Description</p></th><th><p>Code</p></th><th><p>Function</p></th></tr><tr><td><p>1</p></td><td><p>Fitting tool</p></td><td><p>1.870.854.000</p></td><td><p>Introduction of new oil seal</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/244002532.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]